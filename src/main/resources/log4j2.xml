<Configuration status="WARN" monitorInterval="60">
    <Properties>
        <!-- 톰캣 로그 폴더 아래로 -->
        <Property name="LOG_DIR">${sys:catalina.base}/logs/jsAdmin</Property>

        <!-- 공통 패턴: traceId는 MDC(ThreadContext) 키 traceId 사용 -->
        <Property name="PATTERN">%d{HH:mm:ss.SSS} %-5level [%t] %logger{36} - [traceId=%X{traceId}] %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATTERN}"/>
        </Console>

        <RollingFile name="RollingFile"
                     fileName="${LOG_DIR}/app.log"
                     filePattern="${LOG_DIR}/app-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="20"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- 프로젝트 패키지: DEBUG까지 보고 싶으면 debug -->
        <Logger name="com.realhogoo" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- MyBatis SQL/파라미터 로그 확인용 -->
        <Logger name="org.mybatis" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>
        <Logger name="org.apache.ibatis" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- Spring은 너무 시끄러우면 info -->
        <Logger name="org.springframework" level="info" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>
    </Loggers>
